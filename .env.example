# Copy to .env.local (never commit real keys).

# "fixtures" reads saved snapshots from ./fixtures; "live" calls the APIs.
# Defaults: fixtures in `next dev`, live in production builds.
DATA_MODE=fixtures

# Currents API (https://currentsapi.services) - free tier: 250 requests/day.
CURRENTS_API_KEY=

# GridNews (https://www.gridnews.io) - keep disabled in production until
# GridNews confirms the free tier allows public display.
GRIDNEWS_ENABLED=false
GRIDNEWS_API_KEY=
