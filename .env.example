# Copy to .env.local (never commit real keys).

# "fixtures" reads saved snapshots from ./fixtures; "live" calls the APIs.
# Defaults: fixtures in `next dev`, live in production builds.
DATA_MODE=fixtures

# GridNews (https://www.gridnews.io) is the only source that needs a key.
# Keep it disabled in production until GridNews confirms the free tier
# allows public display.
GRIDNEWS_ENABLED=false
GRIDNEWS_API_KEY=
